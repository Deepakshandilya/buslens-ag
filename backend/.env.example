APP_ENV=local

# SQLite database file path (relative for local dev, absolute on EC2)
DB_PATH=buslens.db
# DB_PATH=/var/lib/buslens/buslens.db

# Comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP for OTP emails (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
OTP_EXPIRE_MINUTES=10

# Google OAuth — get credentials from console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Authentication
SECRET_KEY=your-super-secret-key-for-local-dev-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
